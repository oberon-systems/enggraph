# What of this tree becomes a node in the code graph.
#
# Generated by `make install` from the file types actually present
# here. This file REPLACES the default selection rather than adding
# to it, so deleting a line removes that file type from the graph.

# Code, read by the graphifyy extractor (84 files)
*.py
*.ts
*.tsx

# Ansible (8 files)
*.yaml
*.yml

# Bash (8 files)
*.sh

# HTML (1 file)
*.html

# JSON (10 files)
*.json

# JavaScript (2 files)
*.mjs

# Markdown (25 files)
*.md

# TOML (1 file)
*.toml

# File node only, no parser reads inside these (10 files)
*.sql

# Matched by name rather than by extension
Dockerfile
Makefile

# Supported but absent from this tree: .bash, .c, .cc, .cjs, .cpp, .cs, .cxx,
#   .dockerfile, .epp, .erb, .go, .h, .hcl, .hpp, .htm, .java, .js, .jsx, .kt,
#   .markdown, .mk, .php, .phtml, .pp, .rb, .rs, .scala, .tf, .tfvars

# Kept by hand: nginx configuration. The generator names only the types it
# has a parser or the extractor for, so a re-run drops this line - and the
# file becomes a file node with a summary and no entities.
*.conf
