# Local environment
.env

# Python
.venv/
__pycache__/
*.py[cod]
.ruff_cache/

# Node
node_modules/
dist/

# Jekyll (docs/), built locally to verify the Pages theme
docs/_site/
docs/.bundle/
docs/.jekyll-cache/

# IDEs
.idea/
.vscode/

# Rendered agent state. Every skill's source lives in skills/ and is tracked;
# `make skill-install` renders a copy into these two directories, so only the
# rendered output is ignored.
/.claude/skills/
.gemini/skills/

# Personal permissions and the session checkpoint artifact: local, never shared.
/.claude/settings.local.json
/.claude/RESUME.md

# The llama.cpp release unpacked by `worker/get-llama-server.bat`: several
# hundred MB of binaries that belong to a machine, not to the repository.
/worker/llama-server/

# The extractor's own output directory. Inside the container it is a volume;
# this catches a copy left behind by running the extractor on the host.
graphify-out/

# Misc
*.log
.pre-commit
