# Local environment
.env

# Python
.venv/
__pycache__/
*.py[cod]
.ruff_cache/

# Node
node_modules/
dist/

# IDEs
.idea/
.vscode/

# Agent state. The skill itself lives in skills/ and is installed from there by
# `make skill-install`; what lands here is a rendered copy, and where it lands
# depends on the machine.
.claude/skills/
.gemini/skills/

# The extractor's own output directory. Inside the container it is a volume;
# this catches a copy left behind by running the extractor on the host.
graphify-out/

# Misc
*.log
.pre-commit
