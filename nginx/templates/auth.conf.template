# Rendered into conf.d by the nginx image at start, from the service's env.
map $host $auth_enforce {
    default "${AUTH_ENFORCE}";
}

# Zero for a Host that GATEWAY_HOSTS lists, or that names this machine itself:
# a page that rebinds its own name to the gateway carries neither. The list
# comes first and the Host last, after the one `|` the value may hold, so a
# Host cannot pass for a part of the list: the two refusals are tried first.
map ",${GATEWAY_HOSTS},|$http_host" $foreign_host {
    default 1;
    "~\|.*\|" 1;
    "~\|.*[^A-Za-z0-9._:\[\]-]" 1;
    "~^[^|]*,\*,[^|]*\|" 0;
    "~*^[^|]*,([^,|]+),[^|]*\|\1$" 0;
    "~*\|(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$" 0;
}
