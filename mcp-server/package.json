{
  "name": "enggraph-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing the code graph stored in PostgreSQL",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test eval",
    "format": "prettier --write src test eval *.json *.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
