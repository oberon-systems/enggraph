# Copy to .env and adjust. `make up` refuses to run without it.

# Absolute path to the codebase to index. Mounted read-only at /project. It is
# only the default: `make index PROJECT=/somewhere/else` indexes any other tree
# into the same database without touching this file.
PROJECT_PATH=/path/to/your/project

# Name the codebase is stored and addressed under, in the `project` argument of
# the MCP tools and in the /mcp/<name> endpoint. Derived from the last segment
# of PROJECT_PATH when left unset.
# PROJECT_NAME=

# Project a client gets when it connects to a bare /mcp or /sse rather than to
# /mcp/<name>. Left unset, such a session has no default and every tool call
# has to name a project itself.
# DEFAULT_PROJECT=

# PostgreSQL credentials. POSTGRES_PASSWORD has no default on purpose.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=user
POSTGRES_DB=context

# The single entry point. nginx publishes this one host port and routes by
# path: /mcp and /sse to the MCP server, /worker to the summarization API,
# everything else - the dashboard, its API and the graph page - to the
# dashboard. No other service is published.
GATEWAY_PORT=3000

# Interface the entry point binds. 0.0.0.0 is what a summarization worker on
# another machine needs; it also puts the dashboard, which writes to the
# database on behalf of a browser and has no authentication of its own, within
# reach of the local network. Set 127.0.0.1 if you run no remote worker.
GATEWAY_BIND=0.0.0.0

# Host header values the stack answers to. Change this whenever GATEWAY_PORT
# changes, and add the address you reach the stack at from another machine, or
# the MCP server and the dashboard API answer 403 while /health looks fine.
# GATEWAY_HOSTS=localhost:3000,127.0.0.1:3000,[::1]:3000

# The remote summarization worker API (`make api-up`), served at /worker on
# the entry point. Plain HTTP on a trusted LAN or VPN, so this token is the
# only thing between the network and the text of your files. Generate one with
# `openssl rand -hex 24`; the service refuses to start without it, and refuses
# a token shorter than 16 characters.
# WORKER_API_TOKEN=
# How long a claimed batch is held before it returns to the queue, and how
# many files one claim may take.
# WORKER_LEASE_SECONDS=300
# WORKER_MAX_BATCH=8

# How much of each file's text the indexer keeps in graph_nodes.content, which
# is where a worker on another machine reads it from - it has no checkout of
# your tree. 0 stores nothing and turns remote summarizing off. About 4k
# tokens at the default, against the 2000 characters the local pass shows the
# model. Turn it down on a very large tree: an index run holds one of these
# per code file at once.
# CONTENT_STORE_CHARS=16000

# What the indexing and summarizing jobs may take from the machine. They are
# the only unattended ones here, and `make summarize` holds the model for the
# whole pass, so the limits are on that container alone. GRAPHIFY_MEM is a floor rather than a
# preference: the weights are ~1.1 GB before the context window and the
# extraction. LLM_THREADS stays at or below GRAPHIFY_CPUS, and both are what
# decide how long `make summarize` takes: ~30 s per file at 2 threads, ~8 s
# at 8.
# GRAPHIFY_CPUS=2
# GRAPHIFY_MEM=4g
# GRAPHIFY_MEM_RESERVATION=1g
# LLM_THREADS=2

# Tag applied to the images built by `make build`.
TAG=latest
