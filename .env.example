# Copy to .env and adjust. `make up` refuses to run without it.

# Absolute path to the codebase to index. It is only the default:
# `make index PROJECT=/somewhere/else` indexes any other tree into the same
# database without touching this file. Every indexed tree is mounted read-only
# at /code/<project> by docker-compose.override.yaml, which `make mounts`
# writes from the projects table.
PROJECT_PATH=/path/to/your/project

# Name the codebase is stored and addressed under, in the `project` argument of
# the MCP tools and in the /mcp/<name> endpoint. Derived from the last segment
# of PROJECT_PATH when left unset.
# PROJECT_NAME=

# Project a client gets when it connects to a bare /mcp or /sse rather than to
# /mcp/<name>. Left unset, such a session has no default and every tool call
# has to name a project itself.
# DEFAULT_PROJECT=

# PostgreSQL credentials. POSTGRES_PASSWORD has no default on purpose.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=user
POSTGRES_DB=context

# The single entry point. nginx publishes this one host port and routes by
# path: /mcp and /sse to the MCP server, /worker to the summarization API,
# everything else - the dashboard, its API and the graph page - to the
# dashboard. No other service is published.
GATEWAY_PORT=3000

# Interface the entry point binds. 0.0.0.0 is what a summarization worker on
# another machine needs; it also puts the dashboard, which writes to the
# database on behalf of a browser and has no authentication of its own, within
# reach of the local network. Set 127.0.0.1 if you run no remote worker.
GATEWAY_BIND=0.0.0.0

# Host header values the stack answers to. Change this whenever GATEWAY_PORT
# changes, and add the address you reach the stack at from another machine, or
# the MCP server and the dashboard API answer 403 while /health looks fine.
# GATEWAY_HOSTS=localhost:3000,127.0.0.1:3000,[::1]:3000

# The remote summarization worker API (`make api-up`), served at /worker on
# the entry point. Plain HTTP on a trusted LAN or VPN, so this token is the
# only thing between the network and the text of your files. `make up`
# generates one here when this is empty or too short; the service refuses to
# start without it, and refuses a token shorter than 16 characters.
WORKER_API_TOKEN=
# How long a claimed batch is held before it returns to the queue, and how
# many files one claim may take.
# WORKER_LEASE_SECONDS=300
# WORKER_MAX_BATCH=8

# What the indexing and summarizing jobs may take from the machine. They are
# the only unattended ones here, and `make summarize` holds the model for the
# whole pass, so the limits are on that container alone. GRAPHIFY_MEM is a floor rather than a
# preference: the weights are ~1.1 GB before the context window and the
# extraction. LLM_THREADS stays at or below GRAPHIFY_CPUS, and both are what
# decide how long `make summarize` takes: ~30 s per file at 2 threads, ~8 s
# at 8.
# GRAPHIFY_CPUS=2
# GRAPHIFY_MEM=4g
# GRAPHIFY_MEM_RESERVATION=1g
# LLM_THREADS=2

# Where the summary queue is pushed. Unset, nothing is pushed and the queue
# is drained the two ways it always was: `make summarize` in the graphify
# container, and a worker on a machine with a GPU claiming leases from the
# API. A URL stored in the dashboard settings comes before this one, and the
# switch beside it is what turns the push on.
# SUMMARIZE_SERVER_URL=http://192.168.1.10:8080
# SUMMARIZE_SERVER_KEY=
# SUMMARIZE_BATCH=4
# SUMMARIZE_TICK_SECONDS=30

# Where a chunk and a search query become vectors. EMBED_SERVER_URL is the
# primary - a machine with a GPU - and a URL stored in the dashboard settings
# comes before it. The queue only ever uses the primary and waits while it is
# down. EMBED_LOCAL_URL, the `embedder` container beside this stack
# (`make up EMBED=1`), answers search queries when the primary cannot be
# reached; it must run the same model. To embed the queue on it, store its URL
# in the settings. Nothing is dialled until embedding is switched on.
# EMBED_SERVER_URL=http://192.168.1.10:8080
# EMBED_LOCAL_URL=http://embedder:8080
# The token a published server wants (`llama-server --api-key`). A token
# stored on the settings page comes first; this is the fallback for a stack
# configured by file alone, and it has no expiry attached.
# EMBED_SERVER_KEY=
# The model, and the weights file the container loads. Changing the model
# means a migration: the vector column is declared at one width, and vectors
# of two models never share a space.
# EMBED_MODEL=nomic-embed-text-v1.5
# EMBED_MODEL_FILE=nomic-embed-text-v1.5.f16.gguf
# How fast the queue drains. While there is work the loop keeps claiming
# rather than doing a handful and sleeping, so TASKS_PER_TICK is the size of
# one claim and TICK_SECONDS is only how long it waits when the queue is
# empty. BUDGET_SECONDS is how long one pass may work before it re-reads the
# switches, so turning embedding off takes effect within about that.
# EMBED_BATCH=8
# EMBED_TASKS_PER_TICK=8
# EMBED_TICK_SECONDS=10
# EMBED_TICK_BUDGET_SECONDS=60
# EMBED_THREADS=2
# EMBED_CPUS=2
# EMBED_MEM=2g

# Tag applied to the images built by `make build`.
TAG=latest
