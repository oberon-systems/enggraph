# Copy to .env and adjust. `make up` refuses to run without it.

# Absolute path to the codebase to index. Mounted read-only at /project. It is
# only the default: `make index PROJECT=/somewhere/else` indexes any other tree
# into the same database without touching this file.
PROJECT_PATH=/path/to/your/project

# Name the codebase is stored and addressed under, in the `project` argument of
# the MCP tools and in the /mcp/<name> endpoint. Derived from the last segment
# of PROJECT_PATH when left unset.
# PROJECT_NAME=

# Project a client gets when it connects to a bare /mcp or /sse rather than to
# /mcp/<name>. Left unset, such a session has no default and every tool call
# has to name a project itself.
# DEFAULT_PROJECT=

# PostgreSQL credentials. POSTGRES_PASSWORD has no default on purpose.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=user
POSTGRES_DB=context

# Where the database keeps its data directory on the host.
DATA_DIR=./pgdata

# Host port the MCP server is published on.
MCP_PORT=3000

# Host port the graph page is published on. It is also reachable through the
# MCP server at http://localhost:${MCP_PORT}/graph.
VIEWER_PORT=3001

# Tag applied to the images built by `make build`.
TAG=dev

# Name of the compose project, which is what keeps the containers, the network
# and the images of one indexed codebase apart from another's. Left unset, the
# Makefile derives it from PROJECT_PATH; set it here to pin one instead.
# COMPOSE_PROJECT_NAME=ctx-my-project
